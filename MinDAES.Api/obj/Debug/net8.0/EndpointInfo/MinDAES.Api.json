{
  "openapi": "3.0.1",
  "info": {
    "title": "MinDAES.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/Applicant/{examId}/EnrollApplicants": {
      "post": {
        "tags": [
          "Applicant"
        ],
        "parameters": [
          {
            "name": "examId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollApplicantsDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollApplicantsDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollApplicantsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Applicant/{examId}/Enrollments/{enrollmentId}": {
      "delete": {
        "tags": [
          "Applicant"
        ],
        "parameters": [
          {
            "name": "examId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "enrollmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Exam/AddNewExamSchedules": {
      "post": {
        "tags": [
          "Exam"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExamDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Exam/GetExamSchedules": {
      "get": {
        "tags": [
          "Exam"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamScheduleResponseDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamScheduleResponseDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamScheduleResponseDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Question/{examId}/SaveQuestions": {
      "post": {
        "tags": [
          "Question"
        ],
        "parameters": [
          {
            "name": "examId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveExamQuestionsDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveExamQuestionsDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SaveExamQuestionsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicantEnrollmentDto": {
        "required": [
          "email",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "applicantCode": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EnrollApplicantsDto": {
        "required": [
          "applicants"
        ],
        "type": "object",
        "properties": {
          "applicants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicantEnrollmentDto"
            }
          }
        },
        "additionalProperties": false
      },
      "ExamApplicantResponseDto": {
        "type": "object",
        "properties": {
          "examEnrollmentId": {
            "type": "string",
            "format": "uuid"
          },
          "applicantId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "applicantCode": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ExamDto": {
        "type": "object",
        "properties": {
          "examId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "examTitle": {
            "type": "string",
            "nullable": true
          },
          "examCode": {
            "type": "string",
            "nullable": true
          },
          "examDate": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "passingScore": {
            "type": "integer",
            "format": "int32"
          },
          "instructions": {
            "type": "string",
            "nullable": true
          },
          "accessType": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "ExamQuestionOptionResponseDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "nullable": true
          },
          "isCorrect": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ExamQuestionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "points": {
            "type": "integer",
            "format": "int32"
          },
          "required": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamQuestionOptionResponseDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ExamScheduleResponseDto": {
        "type": "object",
        "properties": {
          "examId": {
            "type": "string",
            "format": "uuid"
          },
          "examTitle": {
            "type": "string",
            "nullable": true
          },
          "examDate": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "passingScore": {
            "type": "integer",
            "format": "int32"
          },
          "instructions": {
            "type": "string",
            "nullable": true
          },
          "accessType": {
            "type": "string",
            "nullable": true
          },
          "examCode": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamQuestionResponseDto"
            },
            "nullable": true
          },
          "applicants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamApplicantResponseDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuestionDto": {
        "required": [
          "text",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "minLength": 1,
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "points": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionOptionDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuestionOptionDto": {
        "required": [
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "isCorrect": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SaveExamQuestionsDto": {
        "required": [
          "questions"
        ],
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionDto"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}